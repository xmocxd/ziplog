{
  "name": "ziplog",
  "version": "1.0.0",
  "main": "index.js",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~56.0.8",
    "expo-status-bar": "~56.0.4",
    "nativewind": "^4.2.5",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.8.3"
  },
  "scripts": {
    "start": "expo start",
    "start:fresh": "EXPO_PUBLIC_FORCE_FIRST_RUN=1 EXPO_PUBLIC_ZIPLOG_FRESH_SESSION=$(node scripts/fresh-session.js) expo start",
    "android": "expo start --android",
    "android:fresh": "EXPO_PUBLIC_FORCE_FIRST_RUN=1 EXPO_PUBLIC_ZIPLOG_FRESH_SESSION=$(node scripts/fresh-session.js) expo start --android",
    "ios": "expo start --ios",
    "ios:fresh": "EXPO_PUBLIC_FORCE_FIRST_RUN=1 EXPO_PUBLIC_ZIPLOG_FRESH_SESSION=$(node scripts/fresh-session.js) expo start --ios",
    "web": "expo start --web",
    "web:fresh": "EXPO_PUBLIC_FORCE_FIRST_RUN=1 EXPO_PUBLIC_ZIPLOG_FRESH_SESSION=$(node scripts/fresh-session.js) expo start --web",
    "build:web": "expo export --platform web"
  },
  "private": true,
  "devDependencies": {
    "babel-preset-expo": "^56.0.14",
    "prettier-plugin-tailwindcss": "^0.5.14",
    "tailwindcss": "^3.4.19"
  }
}
